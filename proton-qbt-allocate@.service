[Unit]
Description=Proton qBittorrent Port Allocator and Sync for %i
Requires=proton-wg@%i.service
After=proton-wg@%i.service docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/proton/proton-common.env
EnvironmentFile=-/etc/proton/instances/%i/proton.env
EnvironmentFile=-/etc/proton/instances/%i/qbittorrent.env
ExecStart=/usr/local/bin/proton/proton-qbt-allocate-and-sync.sh %i
Nice=10
TimeoutStartSec=180
UMask=0077

[Install]
WantedBy=multi-user.target
